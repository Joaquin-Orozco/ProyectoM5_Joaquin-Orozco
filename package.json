{
  "name": "automatehub-github-agent",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server para automatizar operaciones de GitHub con lenguaje natural.",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npm run build && npx --yes @modelcontextprotocol/inspector@0.16.0 node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}